<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.DishFlavorMapper">

    <insert id="insertBatch">
        <if test="dishFlavors != null and dishFlavors.size() > 0">
            insert into dish_flavor(dish_id, name, value) values
            <foreach collection="dishFlavors" item="dishFlavor" separator=",">
                (#{dishFlavor.dishId}, #{dishFlavor.name}, #{dishFlavor.value})
            </foreach>
        </if>
    </insert>
    <delete id="deleteByDishIds">
        delete from dish_flavor where dish_id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>
    <select id="getByDishId" resultType="com.sky.entity.DishFlavor">
        select * from dish_flavor where dish_id = #{id}
    </select>

</mapper>